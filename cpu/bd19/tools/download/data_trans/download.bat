@echo off

cd %~dp0

set KEY_FILE=..\..\..\..\..\apps\spp_and_le\board\bd19\012AC690X-8029.key
set KEY_MODE=%TRANS_DATA_KEY_MODE%
set DOWNLOAD_RET=0

if "%KEY_MODE%"=="" set KEY_MODE=AUTO

copy ..\..\tone.cfg .
copy ..\..\cfg_tool.bin .
copy ..\..\app.bin .
copy ..\..\bd19loader.bin .
copy ..\..\p11_code.bin .
copy ..\..\script.ver .

if /I "%KEY_MODE%"=="OFF" (
    echo INFO: download without KEY
    call :run_download
    set DOWNLOAD_RET=%ERRORLEVEL%
    goto after_download
)

if /I "%KEY_MODE%"=="ON" (
    if not exist "%KEY_FILE%" (
        echo ERROR: KEY file not found: %KEY_FILE%
        exit /b 1
    )
    echo INFO: download with KEY file: %KEY_FILE%
    call :run_download -key "%KEY_FILE%"
    set DOWNLOAD_RET=%ERRORLEVEL%
    goto after_download
)

if not exist "%KEY_FILE%" (
    echo WARN: KEY file not found, continue without KEY
    call :run_download
    set DOWNLOAD_RET=%ERRORLEVEL%
    goto after_download
)

echo INFO: auto detect KEY download mode
call :run_download -key "%KEY_FILE%"
set DOWNLOAD_RET=%ERRORLEVEL%
if "%DOWNLOAD_RET%"=="0" goto after_download

echo WARN: KEY download failed, retry without KEY
call :run_download
set DOWNLOAD_RET=%ERRORLEVEL%

:after_download
:: -format all
:: -reboot 2500

rem remove temporary resource files generated by the packer
if exist *.mp3 del *.mp3
if exist *.PIX del *.PIX
if exist *.TAB del *.TAB
if exist *.res del *.res
if exist *.sty del *.sty

rem trans_data development uses direct download by default.
rem Set TRANS_DATA_GEN_UFW=1 only when an upgrade package is explicitly needed.
if /I not "%TRANS_DATA_GEN_UFW%"=="1" goto after_ufw

rem generate upgrade file
..\..\fw_add.exe -noenc -fw jl_isd.fw -add ..\..\ota.bin -type 100 -out jl_isd.fw
if errorlevel 1 exit /b %ERRORLEVEL%
rem add version to jl_isd.fw
..\..\fw_add.exe -noenc -fw jl_isd.fw -add script.ver -out jl_isd.fw
if errorlevel 1 exit /b %ERRORLEVEL%

..\..\ufw_maker.exe -fw_to_ufw jl_isd.fw
if errorlevel 1 exit /b %ERRORLEVEL%
copy jl_isd.ufw update.ufw
if errorlevel 1 exit /b %ERRORLEVEL%
del jl_isd.ufw

:after_ufw

rem format examples:
rem -format vm      erase VM area
rem -format cfg     erase BT CFG area
rem -format 0x3f0-2 erase 2 sectors from sector 0x3f0

rem keep a short delay for downloader teardown; no temp file is created here.
ping /n 2 127.1>nul
exit /b %DOWNLOAD_RET%

:run_download
if "%~1"=="" (
    ..\..\isd_download.exe ..\..\isd_config.ini -tonorflash -dev bd19 -boot 0x2000 -div8 -wait 300 -uboot ..\..\uboot.boot -app ..\..\app.bin ..\..\cfg_tool.bin -res ..\..\p11_code.bin -uboot_compress
) else (
    ..\..\isd_download.exe ..\..\isd_config.ini -tonorflash -dev bd19 -boot 0x2000 -div8 -wait 300 -uboot ..\..\uboot.boot -app ..\..\app.bin ..\..\cfg_tool.bin -res ..\..\p11_code.bin -uboot_compress %*
)
exit /b %ERRORLEVEL%
